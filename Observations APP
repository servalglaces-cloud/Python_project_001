import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3
from datetime import date

# Création de la base de données
conn = sqlite3.connect("observations.db")
cursor = conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS observations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date TEXT,
    eleve TEXT,
    observation TEXT
)
""")
conn.commit()

# Fonction d'enregistrement
def enregistrer():
    eleve = entree_eleve.get()
    observation = texte_obs.get("1.0", tk.END).strip()

    if eleve == "" or observation == "":
        messagebox.showwarning("Attention", "Veuillez remplir tous les champs.")
        return

    cursor.execute(
        "INSERT INTO observations(date, eleve, observation) VALUES (?, ?, ?)",
        (date.today().strftime("%d/%m/%Y"), eleve, observation)
    )
    conn.commit()

    messagebox.showinfo("Succès", "Observation enregistrée.")
    entree_eleve.delete(0, tk.END)
    texte_obs.delete("1.0", tk.END)

# Fonction de recherche
def rechercher():
    eleve = entree_recherche.get()

    resultat.delete("1.0", tk.END)

    cursor.execute(
        "SELECT date, observation FROM observations WHERE eleve=? ORDER BY id DESC",
        (eleve,)
    )

    lignes = cursor.fetchall()

    if not lignes:
        resultat.insert(tk.END, "Aucune observation trouvée.")
    else:
        for d, obs in lignes:
            resultat.insert(tk.END, f"{d}\n{obs}\n")
            resultat.insert(tk.END, "-"*40 + "\n")

# Interface
fenetre = tk.Tk()
fenetre.title("Suivi du comportement des élèves")
fenetre.geometry("700x600")

tk.Label(fenetre, text="Nom de l'élève").pack()
entree_eleve = tk.Entry(fenetre, width=40)
entree_eleve.pack()

tk.Label(fenetre, text="Observation").pack()
texte_obs = tk.Text(fenetre, height=8, width=60)
texte_obs.pack()

tk.Button(fenetre, text="Enregistrer", command=enregistrer).pack(pady=10)

ttk.Separator(fenetre).pack(fill="x", pady=10)

tk.Label(fenetre, text="Rechercher un élève").pack()
entree_recherche = tk.Entry(fenetre, width=40)
entree_recherche.pack()

tk.Button(fenetre, text="Afficher l'historique", command=rechercher).pack()

resultat = tk.Text(fenetre, height=15, width=70)
resultat.pack(pady=10)

fenetre.mainloop()

conn.close()
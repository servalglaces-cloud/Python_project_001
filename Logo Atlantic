t.pendown()

t.write("ÉDUCATION", font=("Arial", 20, "bold"))

t.penup()
t.goto(-100, -200)   # position de départ à gauche
t.pendown()
t.write("BERCHID", font=("Arial", 30, "bold"))

t.hideturtle()
turtle.done()

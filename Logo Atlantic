t = turtle.Turtle()
t.color("skyblue")

t.speed(5)
t.penup()
t.goto(-80, 40)   # position de départ à gauche
t.pendown()
t.write("ATLANTIC ", font=("Arial", 25, "bold"))

t.penup()
